# Llm tool-use loop via Ollama. The price is a value the model CANNOT know, so
# it must call get_price; if the answer is 4217 the tool loop demonstrably ran.
#   ./jet -r agent_tools_live::run examples/agent_tools_live.jet
module agent_tools_live
  agent Shop
    model "ollama:qwen3.6:35b-a3b"
    role "You look up prices. You do NOT know any prices yourself — you MUST call the get_price tool and report exactly the integer it returns as `price`. Never guess."
    ask price_of(item) -> {price: Int}

    tool get_price(item: String), "Look up the catalog price (an integer) of an item by name" do |i|
      4217
    end
  end

  def self.run()
    s = agent_tools_live::Shop.spawn()
    io::format("price_of('blue widget') => ~p   (4217 proves the tool ran)~n", [s.price_of("blue widget").await()])
  end
end
