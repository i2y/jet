# One-shot LLM call
# Usage: ./jet -r LlmOneshot::LlmOneshot.demo examples/llm_oneshot.jet
#
# Set the ANTHROPIC_API_KEY environment variable before running

class LlmOneshot
  def self.demo()
    api_key = os::getenv("ANTHROPIC_API_KEY")

    io::format("=== One-shot chat ===~n", [])
    response = Llm::chat(:claude, "claude-opus-4-8", api_key, "You are a helpful assistant.", "What is Erlang/OTP in one sentence?")
    io::format("Response: ~s~n", [response])
  end
end
