module jet_plan
  # Planning primitives for the shape runners. The headline use is jet_flow: a node that
  # fails or returns nothing is now RETRIED -- and re-attempts REPLAN (the caller reframes
  # the approach via the attempt number) -- instead of being recorded as a bare failure and
  # skipped. Also a small revisable plan-state struct that shapes can track steps with.

  # Run `run.(attempt_no)` up to `max` times until `accept.(result)` holds. A crash counts
  # as a failure (caught, so one bad attempt never kills the turn). attempt_no is 1-based so
  # the caller can vary the approach on a retry (a lightweight replan).
  #   -> {:ok, result, attempts} | {:failed, last, attempts}
  def self.attempt(run, accept, max)
    attempt_loop(run, accept, max, 1)
  end

  def self.attempt_loop(run, accept, max, n)
    outcome = try
      {:ran, run.(n)}
    catch e
      {:crashed, e.get(:reason)}
    end
    match outcome
      case {:ran, out}
        if accept.(out)
          {:ok, out, n}
        else
          retry_or_fail(run, accept, max, n, out)
        end
      case {:crashed, reason}
        retry_or_fail(run, accept, max, n, {:error, reason})
    end
  end

  def self.retry_or_fail(run, accept, max, n, last)
    if n >= max
      {:failed, last, n}
    else
      attempt_loop(run, accept, max, n + 1)
    end
  end

  # --- transient-failure retry (bounded exponential backoff) --------------------
  # The error taxonomy for backend calls: which {:error, reason} values are worth
  # retrying (rate limits, 5xx, transport hiccups) vs terminal (bad key, 4xx,
  # decode failures). Reasons follow the typed shapes Llm.jet / jet_llm produce.

  def self.retryable?(reason)
    match reason
      case {:api_error, status, _body}
        (status == 429) or (status >= 500)
      case {:http_error, _r}
        true
      case :timeout
        true
      case {:timeout, _}
        true
      case _
        false
    end
  end

  # Run `run.()` (-> {:ok, ...} | {:error, reason} | any value) up to `attempts`
  # times, sleeping base_ms * factor^(n-1) (capped at cap_ms) between tries; only
  # a retryable {:error, reason} retries. Emits a {:thought, ...} per retry so the
  # wait is visible instead of a silent stall.
  #   opts: {attempts: 3, base_ms: 1000, factor: 2, cap_ms: 30000} (all optional)
  def self.retry(run, opts)
    retry_loop(run, maps::get(:attempts, opts, 3), maps::get(:base_ms, opts, 1000),
               maps::get(:factor, opts, 2), maps::get(:cap_ms, opts, 30000), 1)
  end

  def self.retry_loop(run, attempts, base, factor, cap, n)
    out = run.()
    match out
      case {:error, reason}
        if (n < attempts) and retryable?(reason)
          jet_acp::emit_event({:thought, erlang::iolist_to_binary(["(retrying after ", describe_err(reason),
            " -- attempt ", erlang::integer_to_binary(n + 1), "/", erlang::integer_to_binary(attempts), ")"])})
          timer::sleep(backoff_ms(base, factor, cap, n))
          retry_loop(run, attempts, base, factor, cap, n + 1)
        else
          out
        end
      case _
        out
    end
  end

  def self.backoff_ms(base, factor, cap, n)
    ms = base * pow_int(factor, n - 1)
    if ms > cap
      cap
    else
      ms
    end
  end

  def self.pow_int(b, e)
    if e <= 0
      1
    else
      b * pow_int(b, e - 1)
    end
  end

  def self.describe_err(reason)
    match reason
      case {:api_error, status, _}
        erlang::iolist_to_binary(["HTTP ", erlang::integer_to_binary(status)])
      case {:http_error, r}
        erlang::iolist_to_binary(io_lib::format("~P", [r, 3]))
      case _
        erlang::iolist_to_binary(io_lib::format("~P", [reason, 3]))
    end
  end

  # --- revisable plan-state: an ordered list of steps, each {id, status, attempts}.
  # status flows pending -> in_progress -> completed | failed; a failed step can be
  # re-marked and retried in place (the "revisable" part). ---

  def self.new(ids)
    lists::map(do |id|
      {id: id, status: :pending, attempts: 0}
    end, ids)
  end

  def self.mark(plan, id, status)
    lists::map(do |s|
      if maps::get(:id, s) == id
        maps::put(:status, status, s)
      else
        s
      end
    end, plan)
  end

  def self.bump(plan, id)
    lists::map(do |s|
      if maps::get(:id, s) == id
        maps::put(:attempts, maps::get(:attempts, s) + 1, s)
      else
        s
      end
    end, plan)
  end

  def self.status_of(plan, id)
    match lists::filter(do |s| maps::get(:id, s) == id end, plan)
      case [s, *_]
        maps::get(:status, s)
      case _
        :unknown
    end
  end

  def self.done?(plan)
    lists::all(do |s| maps::get(:status, s) == :completed end, plan)
  end

  # {status => count} over the plan (e.g. for a progress line).
  def self.counts(plan)
    lists::foldl(do |s, acc|
      st = maps::get(:status, s)
      maps::put(st, maps::get(st, acc, 0) + 1, acc)
    end, maps::new(), plan)
  end
end
