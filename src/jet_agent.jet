module jet_agent
  # Agent runtime (stub runner).
  #
  # `agent` exposed methods desugar to returning the marker
  #   {:jet_agent_async, config, method, args, schema, kind}   # kind = :ask | :task
  # jet_runtime:handle_call sees the marker and makes the call async-by-default:
  # it spawns a worker (run_turn) and immediately replies an AsyncResult future,
  # so the caller is never blocked. `future.await()` yields the turn's result.
  #
  # This stub `dispatch/4` synthesizes a schema-conforming value and validates
  # it. Real runners (Llm: Jet runs the LLM loop; Acp: drive an external agent
  # via Agent Client Protocol) replace dispatch/4 with an actual turn.

  # Worker entry: runs the turn and delivers the result to the caller.
  def self.run_turn(caller, ref, config, method, args, schema, kind)
    # stash the stream target so runners can emit {ref, {:item, chunk}} as
    # output arrives; the final value is delivered as {ref, {:done, result}}.
    erlang::put(:__acp_stream__, {caller, ref})
    match args
      case [:jet_describe]
        # agent-structure probe: reply the static composition, run nothing
        caller ! {ref, {:item, {:describe, describe(config)}}}
        caller ! {ref, {:done, :ok}}
      case [:jet_list_commands]
        # slash-command probe on a native (non-ACP) runner: no commands -> reply [] (no real turn).
        # ACP runners never reach here; they're intercepted in jet_runtime's :Acp branch.
        caller ! {ref, {:item, {:commands, []}}}
        caller ! {ref, {:done, :ok}}
      case [:jet_manifest]
        # surface probe: the agent's STATIC config (role, tools, exposed methods + their
        # param names, skills). `jet mcp-serve` turns it into the MCP tool/resource/prompt
        # lists. Runs nothing, exactly like :jet_describe.
        caller ! {ref, {:item, {:manifest, config}}}
        caller ! {ref, {:done, :ok}}
      case _
        jet_usage::reset()                     # per-turn metering (this worker process)
        # the turn is the OpenTelemetry root span: every shape node, backend call and tool
        # this worker runs nests under it, so one trace = one turn. No-op unless an OTLP
        # endpoint is configured (see jet_otel).
        span = jet_otel::start_turn(<<"jet.agent.turn">>, turn_attrs(config, method, kind))
        result = try
          dispatch(config, method, args, schema, kind)
        catch e
          {:error, :agent_turn_crashed, e.get(:class), e.get(:reason)}
        end
        jet_usage::emit_turn_total()           # one whole-turn aggregate, before done
        jet_otel::end_turn(span, turn_status(result),
                           jet_otel::turn_usage_attrs(jet_usage::turn_total()))
        caller ! {ref, {:done, result}}
    end
  end

  # what the turn's root span says about the agent that ran it.
  def self.turn_attrs(config, method, kind)
    maps::from_list([{<<"jet.agent.runner">>, erlang::atom_to_binary(runner_name(config), :utf8)},
                     {<<"jet.agent.method">>, jet_otel::to_bin(method)},
                     {<<"jet.agent.kind">>, jet_otel::to_bin(kind)}])
  end

  # every error result this runtime produces is an :error tuple, whatever its arity.
  def self.turn_status(result)
    if erlang::is_tuple(result) and (erlang::tuple_size(result) > 0)
         and (erlang::element(1, result) == :error)
      "error"
    else
      "ok"
    end
  end

  def self.dispatch(config, method, args, schema, kind)
    name = runner_name(config)
    match check_runner_opts(name, config)
      case :ok
        route(name, config, method, args, schema, kind)
      case err
        err
    end
  end

  # Check the runner's option keys against the SHAPE'S OWN manifest
  # (`<module>::runner_opts_spec/0`). Only UNRECOGNISED keys are an error: a
  # missing key usually has a legitimate substitute (a Fleet can carry `model:`
  # on each member instead of on the group), while `member:` for `members:` is
  # unambiguously a typo -- and used to produce an empty fleet in silence.
  #
  # The manifest lives with the shape, never in the compiler, so adding a shape
  # stays "one module + one dispatch line + its own spec".
  def self.check_runner_opts(name, config)
    match accepted_opts(name)
      case nil
        :ok
      case allowed
        unknown = lists::filter({|k| unknown_opt?(k, allowed)},
                                maps::keys(jet_backend::opts(config)))
        if unknown == []
          :ok
        else
          {:error, {:unknown_runner_options, name, lists::sort(unknown), lists::sort(allowed)}}
        end
    end
  end

  def self.unknown_opt?(k, allowed)
    (not lists::member(k, allowed)) and (not internal_opt?(k))
  end

  # keys the runtime injects (:__mem__, :__mcp_conns__, …) are never user-written
  def self.internal_opt?(k)
    lists::prefix("__", erlang::atom_to_list(k))
  end

  def self.accepted_opts(name)
    match runner_module(name)
      case nil
        nil
      case mod
        code::ensure_loaded(mod)
        if erlang::function_exported(mod, :runner_opts_spec, 0)
          erlang::apply(mod, :runner_opts_spec, [])
        else
          nil                          # a shape that declares nothing is not checked
        end
    end
  end

  # :Fleet -> :jet_fleet, by the same convention every shape already follows.
  def self.runner_module(name)
    if name == :Plan
      :jet_planner
    elsif lists::member(name, known_runners()) and (name != :Stub)
      erlang::binary_to_atom(erlang::iolist_to_binary(
        ["jet_", string::lowercase(erlang::atom_to_binary(name, :utf8))]), :utf8)
    else
      nil                              # unknown, or the offline stub (takes anything)
    end
  end

  def self.route(name, config, method, args, schema, kind)
    match name
      case :Acp
        jet_acp::turn(config, method, args, schema)
      case :Llm
        jet_llm::turn(config, method, args, schema)
      case :Fleet
        jet_fleet::turn(config, method, args, schema)
      case :Pipeline
        jet_pipeline::turn(config, method, args, schema)
      case :Refine
        jet_refine::turn(config, method, args, schema)
      case :Debate
        jet_debate::turn(config, method, args, schema)
      case :Auto
        jet_auto::turn(config, method, args, schema)
      case :Architect
        jet_architect::turn(config, method, args, schema)
      case :Flow
        jet_flow::turn(config, method, args, schema)
      case :Goal
        jet_goal::turn(config, method, args, schema)
      case :Plan
        jet_planner::turn(config, method, args, schema)
      case :Fake
        jet_fake::turn(config, method, args, schema, kind)
      case :Stub
        stub_turn(config, schema, kind)
      case :stub                      # no runner declared at all
        stub_turn(config, schema, kind)
      case other
        # A NAME WE DO NOT KNOW IS AN ERROR. This used to fall through to the
        # stub, which SYNTHESIZES a schema-conforming value -- so `runner Fleeet`
        # (one typo) returned plausible fabricated data and looked like a success.
        # A wrong runner name is never something to guess at.
        {:error, {:unknown_runner, other, known_runners()}}
    end
  end

  def self.known_runners()
    [:Acp, :Llm, :Fake, :Stub,
     :Fleet, :Pipeline, :Refine, :Debate, :Auto, :Architect, :Flow, :Goal, :Plan]
  end

  def self.runner_name(config)
    runner = maps::get(:runner, config, nil)
    if erlang::is_map(runner)
      maps::get(:name, runner, :stub)
    else
      :stub
    end
  end

  # --- cancellation -----------------------------------------------------------

  # cancel an agent's in-flight turn from outside (Console Stop, ACP
  # session/cancel, or user code): jet_agent::cancel(pid) -> :ok | :no_turn.
  # The agent process and its session SURVIVE; only the turn ends (with
  # {:error, :cancelled}). No `.cancel()` method sugar -- a user agent may
  # define its own `cancel`.
  def self.cancel(apid)
    gen_server::call(apid, :__jet_cancel__, 10000)
  end

  # runs inside the agent gen_server (jet_runtime's :__jet_cancel__ clause).
  def self.cancel_turn(self_obj)
    st = erlang::element(3, self_obj)
    conn = maps::get(:__acp_conn__, st, nil)
    tpid = maps::get(:__turn_pid__, st, nil)
    if (conn != nil) and erlang::is_process_alive(conn)
      conn ! :__cancel_turn__          # ACP/claude conn: graceful (session/cancel | interrupt)
      :ok
    elsif (tpid != nil) and erlang::is_process_alive(tpid)
      tpid ! :__cancel_turn__          # shape collect loops handle this gracefully...
      erlang::spawn(:jet_agent, :cancel_watchdog, [tpid, maps::get(:__turn_ref__, st, nil)])
      :ok
    else
      :no_turn
    end
  end

  # ...but a worker blocked inside gun's selective receive never sees the
  # graceful message -- after a few seconds kill it and complete the caller's
  # future ourselves, so nothing waits out the 600s await timeout.
  def self.cancel_watchdog(tpid, tref)
    timer::sleep(4000)
    if erlang::is_process_alive(tpid)
      erlang::exit(tpid, :kill)
      match tref
        case {caller, ref}
          caller ! {ref, {:done, {:error, :cancelled}}}
        case _
          :ok
      end
    else
      :ok
    end
  end

  # stash the native turn worker's pid + reply address in agent state, so
  # cancel_turn can reach it (mirrors how :__acp_conn__ lives in state).
  def self.remember_turn(self_obj, tpid, caller, ref)
    st = erlang::element(3, self_obj)
    erlang::setelement(3, self_obj,
      maps::put(:__turn_pid__, tpid, maps::put(:__turn_ref__, {caller, ref}, st)))
  end

  # a structured description of an agent's COMPOSITION (its declared runner shape + key params),
  # for the Console's agent-structure visualizer. Pure: reads the static config, runs nothing.
  def self.describe(config)
    runner = maps::get(:runner, config, nil)
    opts = if erlang::is_map(runner)
      maps::get(:opts, runner, maps::new())
    else
      maps::new()
    end
    {runner: runner_name(config),
     model: maps::get(:model, opts, nil),
     drives: maps::get(:drives, opts, nil),
     models: maps::get(:models, opts, []),
     select: maps::get(:select, opts, nil),
     via: via_name(maps::get(:via, opts, nil)),
     memory: maps::get(:memory, config, nil)}
  end

  def self.via_name(via)
    if erlang::is_map(via)
      maps::get(:name, via, nil)
    else
      via
    end
  end

  # Get-or-create the agent's persistent ACP connection (stored in agent state
  # so the session is reused across turns). Returns {conn_pid, new_self}.
  def self.ensure_acp_conn(self_obj, config, agent_pid)
    state = erlang::element(3, self_obj)
    existing = maps::get(:__acp_conn__, state, nil)
    if fresh?(config)
      if alive?(existing)
        existing ! :__close__       # :fresh -> drop the prior session each turn
      end
      open_and_store(self_obj, config, agent_pid, state)
    elsif alive?(existing)
      {existing, self_obj}
    else
      open_and_store(self_obj, config, agent_pid, state)
    end
  end

  def self.open_and_store(self_obj, config, agent_pid, state)
    cmd = jet_acp::command_of(maps::get(:runner, config, nil))
    conn = if jet_claude::native?(cmd)
      jet_claude::open_connection(config, agent_pid)   # bare `claude` -> native CLI (no ACP adapter)
    else
      jet_acp::open_connection(config, agent_pid)       # claude-code-acp / codex / gemini / ... -> ACP
    end
    {conn, erlang::setelement(3, self_obj, maps::put(:__acp_conn__, conn, state))}
  end

  def self.fresh?(config)
    maps::get(:memory, config, :session) == :fresh
  end

  # Get-or-create the agent's native memory (a per-agent ETS table OWNED by this
  # gen_server, so the one-shot turn worker writes to it directly and it survives the
  # worker). `:fresh` -> no memory (stateless, as the native path was before). Returns
  # {tid_or_nil, new_self}. The tid is also injected into the worker's config (`:__mem__`)
  # so the Llm runner can thread conversation history + facts. See jet_memory.
  def self.ensure_mem(self_obj, config)
    if fresh?(config) or server_owned?()
      {nil, self_obj}
    else
      state = erlang::element(3, self_obj)
      existing = maps::get(:__mem__, state, nil)
      if existing != nil
        {existing, self_obj}
      else
        handle = jet_memory::open(mem_opts(config))
        {handle, erlang::setelement(3, self_obj, maps::put(:__mem__, handle, state))}
      end
    end
  end

  # memory id: `memory "<id>"` (a STRING -- Jet string literals are char lists, not
  # binaries) -> DURABLE, snapshot-backed (survives restart). `memory :session` (an atom,
  # the default) or no `memory` decl (nil) -> ephemeral in-RAM. (`:fresh` handled above.)
  def self.mem_opts(config)
    m = maps::get(:memory, config, :session)
    if string_id?(m)
      {id: m}
    else
      maps::new()
    end
  end

  def self.string_id?(m)
    erlang::is_binary(m) or (erlang::is_list(m) and m != [])
  end

  # Under `jet acp-serve`, the ACP server OWNS conversation memory (it does replay +
  # loadSession), so a server-driven agent must NOT also remember -- otherwise the
  # transcript is double-counted (the server threads it AND the agent re-threads/stores
  # it). The server registers :jet_acp_router; its presence means "defer to the server".
  # `jet mcp-serve` owns the conversation the same way (jet_mcp::conv_text), so its router
  # counts too -- otherwise an Llm agent served over MCP would re-thread AND re-store the
  # transcript the server already prefixed, nesting it deeper every turn.
  def self.server_owned?()
    (erlang::whereis(:jet_acp_router) != :undefined)
      or (erlang::whereis(:jet_mcp_router) != :undefined)
  end

  # Get-or-create the agent's PERSISTENT MCP connections (one supervised process per declared
  # server, held in agent state so the subprocess + discovered tools are reused across turns,
  # and server-side session state survives). Mirrors ensure_acp_conn. The conn refs are passed
  # to the worker via config (`:__mcp_conns__`). Returns {[conn_pid], new_self}.
  def self.ensure_mcp_conns(self_obj, config, agent_pid)
    specs = jet_mcp_client::norm_specs(maps::get(:mcp, config, []))
    if specs == []
      {[], self_obj}
    else
      state = erlang::element(3, self_obj)
      existing = maps::get(:__mcp_conns__, state, nil)
      if alive_list?(existing)
        {existing, self_obj}
      else
        # the config goes along so a server that calls BACK (sampling/roots) is answered
        # with the agent's own backend and workspace, not with a refusal.
        conns = lists::map({|s| jet_mcp_client::open_conn(s, agent_pid, config)}, specs)
        {conns, erlang::setelement(3, self_obj, maps::put(:__mcp_conns__, conns, state))}
      end
    end
  end

  def self.alive_list?(conns)
    erlang::is_list(conns) and conns != [] and lists::all({|c| jet_mcp_client::alive?(c)}, conns)
  end

  def self.alive?(pid)
    if erlang::is_pid(pid)
      erlang::is_process_alive(pid)
    else
      false
    end
  end

  # stub runner: :ask -> synthesize a schema-conforming value; :task -> a
  # placeholder TurnResult (so the new ask/task surface is testable offline).
  def self.stub_turn(config, schema, kind)
    match kind
      case :task
        # emit structured events so `.stream do |ev|` is demonstrable offline
        jet_acp::emit_event({:plan, ["analyze", "edit", "verify"]})
        jet_acp::emit_event({:tool_call, {id: "t1", title: "run tests", kind: "execute", status: "completed"}})
        jet_acp::emit_event({:text, "stub: did the work"})
        # the declared tools flow declaration -> runner -> TurnResult; a real
        # runner would resolve + invoke them mid-turn (function-call / MCP loop).
        jet_agent::TurnResult.new({text: "stub: did the work",
                                   ok: true,
                                   edits: [],
                                   commands: [],
                                   plan: ["analyze", "edit", "verify"],
                                   tool_calls: maps::get(:tools, config, []),
                                   files: []})
      case _
        value = gen_value(schema)
        match validate(value, schema)
          case {:ok, v}
            v
          case {:error, reason}
            {:error, :schema_validation, reason}
        end
    end
  end

  # --- stub value synthesis (pretends to be a structured LLM response) ---

  def self.gen_value(schema)
    s = jet_sap::strip_desc(schema)
    if erlang::is_atom(s)
      gen_scalar(s)
    elsif jet_sap::optional?(s)
      gen_value(jet_sap::opt_inner(s))
    elsif jet_sap::enum?(s)
      erlang::hd(jet_sap::enum_values(s))
    elsif erlang::is_tuple(s)
      {_, elem_schema} = s
      [gen_value(elem_schema)]
    elsif erlang::is_map(s)
      maps::map({|_k, v| gen_value(v)}, s)
    else
      nil
    end
  end

  def self.gen_scalar(t)
    match t
      case :string
        "stub"
      case :int
        0
      case :float
        0.0
      case :bool
        true
      case :atom
        :stub
      case _
        nil
    end
  end

  # --- schema handling: delegated to jet_sap (Schema-Aligned Parsing) ---
  #
  # A declared `-> Type` is enforced in exactly one place for every runner and
  # every shape. These two are kept here because the stub runner and older callers
  # name them; the implementation -- lenient parse, schema-guided coercion, scored
  # candidate selection -- lives in jet_sap.

  def self.validate(value, schema)
    jet_sap::validate(value, schema)
  end

  def self.conforms(value, schema)
    jet_sap::conforms(value, schema)
  end


  # The result of a `task` (action) turn: the WORK the agent did, not a coerced
  # answer. Built from ACP's structured tool_call/edit/plan stream (vs `ask`,
  # which returns a typed value). Fields default empty so partial turns are ok.
  class TurnResult
    def initialize(fields)
      @fields = fields
      self
    end

    def text()
      maps::get(:text, @fields, <<>>)
    end

    def ok?()
      maps::get(:ok, @fields, true)
    end

    def edits()
      maps::get(:edits, @fields, [])
    end

    def commands()
      maps::get(:commands, @fields, [])
    end

    def plan()
      maps::get(:plan, @fields, [])
    end

    def tool_calls()
      maps::get(:tool_calls, @fields, [])
    end

    def files()
      maps::get(:files, @fields, [])
    end

    def to_map()
      @fields
    end
  end

  class AsyncResult
    def initialize(ref)
      @ref = ref
      self
    end

    def await()
      r0 = @ref
      jet_acp::wire("TRC ", "await:start")
      receive
        case {r, {:done, result}} if r == r0
          jet_acp::wire("TRC ", "await:got-done")
          result
        case {r, {:item, _}} if r == r0
          await()
      after 600000     # a whole turn may be a multi-stage agent pipeline (minutes)
        jet_acp::wire("TRC ", "await:TIMEOUT")
        {:error, :agent_await_timeout}
      end
    end

    # stream the turn's items to `callback` as they arrive; returns the final
    # result. e.g.  agent.ask("...").stream do |chunk| display(chunk) end
    def stream(callback)
      r0 = @ref
      receive
        case {r, {:done, result}} if r == r0
          result
        case {r, {:item, item}} if r == r0
          callback.(item)
          stream(callback)
      after 600000     # a whole turn may be a multi-stage agent pipeline (minutes)
        {:error, :agent_await_timeout}
      end
    end
  end

  # ===== Unit tests:  ./jet -r jet_agent::run_tests src/jet_agent.jet =====
  #
  # The option sets below are the ones that actually appear across examples/ and
  # console/agents/, so a manifest that is too narrow fails here rather than in
  # someone's program.

  def self.ok_cases()
    [{:Acp, [:command]},
     {:Llm, [:model, :structured, :provider, :api_key, :think, :options]},
     {:Fake, [:replies]},
     {:Fleet, [:drives, :ground, :members, :model, :nodes, :reduce, :retry,
               :workspace, :lead, :max_parallel]},
     {:Pipeline, [:model, :stages]},
     {:Refine, [:critic, :max_rounds, :model, :worker, :models, :select, :router]},
     {:Debate, [:agents, :judge, :model, :rounds]},
     {:Auto, [:model, :router, :shapes]},
     {:Architect, [:drives, :designer]},
     {:Flow, [:drives, :designer, :max_parallel, :retry, :nodes]},
     {:Goal, [:accept, :checker, :drives, :max_rounds, :model, :models, :router,
              :select, :surface, :via, :doer]},
     {:Plan, [:model, :planner, :worker, :via, :max_steps, :max_replans]},
     {:Stub, [:model]},
     {:stub, []}]
  end

  def self.cfg(name, keys)
    {runner: {name: name, opts: lists::foldl({|k, m| maps::put(k, 1, m)}, maps::new(), keys)}}
  end

  def self.test_manifests_accept_real_configs()
    bad = lists::filter({|c| check_runner_opts(erlang::element(1, c),
                                               cfg(erlang::element(1, c), erlang::element(2, c))) != :ok},
                        ok_cases())
    {bad == [], bad, []}
  end

  def self.test_unknown_option_rejected()
    r = check_runner_opts(:Fleet, cfg(:Fleet, [:member]))
    {erlang::element(1, r) == :error, r, :error}
  end

  def self.test_internal_options_allowed()
    r = check_runner_opts(:Llm, cfg(:Llm, [:model, :__mem__]))
    {r == :ok, r, :ok}
  end

  def self.test_unknown_runner_errors()
    r = dispatch(cfg(:Fleeet, [:members]), :m, [], :any, :ask)
    {erlang::element(1, r) == :error, r, :error}
  end

  def self.run_tests()
    ts = [{"manifests_accept_real_configs", test_manifests_accept_real_configs()},
          {"unknown_option_rejected", test_unknown_option_rejected()},
          {"internal_options_allowed", test_internal_options_allowed()},
          {"unknown_runner_errors", test_unknown_runner_errors()}]
    lists::foreach({|t| report(t)}, ts)
    bad = lists::filter({|t| erlang::element(1, erlang::element(2, t)) == false}, ts)
    io::format("~n~p/~p passed~n", [erlang::length(ts) - erlang::length(bad), erlang::length(ts)])
  end

  def self.report(t)
    {name, r} = t
    {ok, got, want} = r
    if ok
      io::format("  ok   ~s~n", [name])
    else
      io::format("  FAIL ~s~n         got:      ~P~n         expected: ~P~n", [name, got, 8, want, 8])
    end
  end
end
