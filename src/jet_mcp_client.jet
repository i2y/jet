module jet_mcp_client
  # MCP *client*: lets a Jet agent CONSUME an external MCP server (the mirror of jet_mcp,
  # which is the server). It spawns the server as a subprocess and speaks MCP JSON-RPC over
  # stdio -- reusing jet_port_ffi (process) + jet_json_ffi (JSON), exactly as jet_acp drives
  # external ACP agents.
  #
  # Like the ACP client, the connection is BIDIRECTIONAL: everything the server puts on the
  # wire is served, not skipped.
  #   server -> client REQUESTS: ping, roots/list, sampling/createMessage. Sampling runs on
  #     the agent's OWN backend, so a server that wants a model borrows ours -- the mirror of
  #     jet_acp answering an ACP agent's fs/terminal requests.
  #   server -> client NOTIFICATIONS: progress + logging are emitted on the same event bus as
  #     {:text}/{:trace}, so an MCP server's progress reaches a Console or a test instead of
  #     vanishing.
  # All three MCP primitives are available, not just tools: tools/*, resources/*, prompts/*.
  #
  # connect/1 returns {:ok, port, descriptors}: each descriptor is a normal Jet tool map
  #   {name, desc, json_schema, mcp: port}
  # so jet_llm's tool loop treats a remote tool exactly like a local `tool` impl -- except
  # invoke_tool sees the `:mcp` key and forwards the call to the server (see jet_llm).
  #
  # Transport is stdio, as ACP's is. The Streamable-HTTP transport is a separate follow-up
  # (it needs response headers out of the HTTP FFI, for Mcp-Session-Id).
  #
  # Per-port connection state (buffer + request id) lives in the process dictionary: the
  # turn worker that opens the port is the only one that reads/writes it, sequentially.

  def self.protocol_version()
    <<"2025-06-18">>
  end

  def self.client_info()
    {name: "jet", version: "0.1.0"}
  end

  # what WE can do for the server. Declared only when true: `roots` we always serve, and
  # `sampling` only when the agent has a backend to sample with -- a capability advertised
  # and then refused is worse than one never offered. (No `elicitation`: headless, there is
  # no user to ask, and fabricating an answer to the server's schema would be a lie.)
  def self.capabilities(backend)
    base = {roots: {listChanged: false}}
    if backend == nil
      base
    else
      maps::put(:sampling, maps::new(), base)
    end
  end

  def self.init_params(backend)
    {protocolVersion: protocol_version(),
     capabilities: capabilities(backend),
     clientInfo: client_info()}
  end

  # --- one-shot connection (standalone use; the agent path uses open_conn below) ---

  def self.connect(cmd)
    connect(cmd, maps::new())
  end

  def self.connect(cmd, config)
    match open_port(cmd, config)
      case {:ok, port}
        handshake(port, config)
      case {:error, reason}
        {:error, reason}
    end
  end

  def self.handshake(port, config)
    stash(config)
    send_req(port, 1, "initialize", init_params(backend_of(config)))
    match recv(port, <<>>, 1)
      case {:ok, resp, buf1}
        remember_server(resp)
        send_note(port, "notifications/initialized", maps::new())
        send_req(port, 2, "tools/list", maps::new())
        match recv(port, buf1, 2)
          case {:ok, r2, buf2}
            put_buf(port, buf2)
            erlang::put({:__mcp_id__, port}, 3)
            {:ok, port, descriptors(port, tools_of(r2))}
          case {:error, reason, _rest}
            jet_port_ffi::close(port)
            {:error, reason}
        end
      case {:error, reason, _rest}
        jet_port_ffi::close(port)
        {:error, reason}
    end
  end

  def self.tools_of(resp)
    result_list(resp, <<"tools">>)
  end

  def self.result_list(resp, key)
    v = maps::get(key, maps::get(<<"result">>, resp, maps::new()), [])
    if erlang::is_list(v)
      v
    else
      []
    end
  end

  # a server tool {name, description, inputSchema} -> a Jet tool descriptor. The inputSchema
  # is already JSON Schema, so it's carried verbatim as :json_schema (jet_llm passes it
  # straight to the model). :mcp marks it remote so invoke_tool forwards the call.
  # `ref` is the port (one-shot use) or the conn process pid (the agent path) -- invoke_tool
  # in jet_llm dispatches on which it is.
  def self.descriptors(ref, tools)
    if erlang::is_list(tools)
      lists::map({|t| descriptor(ref, t)}, tools)
    else
      []
    end
  end

  def self.descriptor(ref, t)
    name = maps::get(<<"name">>, t, <<"tool">>)
    {name: erlang::binary_to_atom(name, :utf8),
     desc: maps::get(<<"description">>, t, name),
     json_schema: maps::get(<<"inputSchema">>, t, maps::new()),
     mcp: ref}
  end

  # call a remote tool: tools/call with the raw args map; return its text content.
  def self.call(port, name, args)
    id = next_id(port)
    send_req(port, id, "tools/call", {name: to_bin(name), arguments: args})
    match recv(port, get_buf(port), id)
      case {:ok, resp, rest}
        put_buf(port, rest)
        extract(resp)
      case {:error, reason, rest}
        put_buf(port, rest)
        failure(<<"call">>, reason)
    end
  end

  # MCP tool result: {result: {content: [{type: "text", text: ...}, ...]}} -> joined text.
  # An isError result is text too -- the model is meant to read it and recover.
  # An error RESPONSE is checked first: its result is absent, so `content` would default to
  # [] -- which is a list, and would quietly render the failure as an empty string.
  def self.extract(resp)
    if maps::is_key(<<"error">>, resp)
      error_text(resp)
    else
      content = maps::get(<<"content">>, maps::get(<<"result">>, resp, maps::new()), [])
      if erlang::is_list(content)
        erlang::iolist_to_binary(lists::map({|b| block_text(b)}, content))
      else
        <<>>
      end
    end
  end

  def self.error_text(resp)
    match maps::get(<<"error">>, resp, nil)
      case nil
        <<>>
      case e
        erlang::iolist_to_binary(["mcp error: ", to_bin(maps::get(<<"message">>, e, <<"unknown">>))])
    end
  end

  # a text/resource content block -> text. A resource block carries its payload inline, so
  # unwrap it rather than dropping the block on the floor.
  def self.block_text(b)
    if erlang::is_map(b)
      match maps::get(<<"type">>, b, nil)
        case <<"resource">>
          to_bin(maps::get(<<"text">>, maps::get(<<"resource">>, b, maps::new()), <<>>))
        case _
          to_bin(maps::get(<<"text">>, b, <<>>))
      end
    else
      <<>>
    end
  end

  def self.failure(what, reason)
    erlang::iolist_to_binary(["mcp ", what, " failed: ", io_lib::format("~p", [reason])])
  end

  def self.close(port)
    erlang::erase({:__mcp_buf__, port})
    erlang::erase({:__mcp_id__, port})
    jet_port_ffi::close(port)
  end

  # --- PERSISTENT connection: one process owns the MCP server subprocess + its discovered
  # tools ACROSS turns (so the server isn't re-spawned each turn, and any server-side session
  # state survives). The turn worker sends it {:mcp_call,...}/{:mcp_tools,...}; the process
  # monitors the agent and closes the port when the agent dies. Mirrors jet_acp's connection. ---

  def self.open_conn(spec, agent_pid)
    open_conn(spec, agent_pid, maps::new())
  end

  def self.open_conn(spec, agent_pid, config)
    erlang::spawn(:jet_mcp_client, :conn_init, [spec, agent_pid, config])
  end

  def self.conn_init(spec, agent_pid, config)
    erlang::monitor(:process, agent_pid)
    stash(config)
    match open_port(spec, config)
      case {:ok, port}
        handshake_then_loop(port, config)
      case {:error, _reason}
        :error
    end
  end

  def self.handshake_then_loop(port, config)
    send_req(port, 1, "initialize", init_params(backend_of(config)))
    match recv(port, <<>>, 1)
      case {:ok, resp, buf1}
        remember_server(resp)
        send_note(port, "notifications/initialized", maps::new())
        send_req(port, 2, "tools/list", maps::new())
        match recv(port, buf1, 2)
          case {:ok, r2, buf2}
            conn_loop(port, descriptors(erlang::self(), tools_of(r2)), buf2, 3)
          case {:error, _r, _rest}
            jet_port_ffi::close(port)
        end
      case {:error, _r, _rest}
        jet_port_ffi::close(port)
    end
  end

  # the conn process: serve tool listings + calls + resource/prompt reads sequentially;
  # threaded buf/id (no process dict). Exits (closing the port) when the agent goes DOWN
  # or the server exits.
  def self.conn_loop(port, tools, buf, next_id)
    receive
      case {:mcp_tools, from, ref}
        {tools2, buf2, id2} = refresh_tools(port, tools, buf, next_id)
        from ! {ref, tools2}
        conn_loop(port, tools2, buf2, id2)
      case {:mcp_call, from, ref, name, args, stream}
        with_stream(stream)
        {result, buf2, st} = do_call(port, next_id, name, args, buf)
        from ! {ref, result}
        continue(st, port, tools, buf2, next_id + 1)
      case {:mcp_rpc, from, ref, method, params, pick, stream}
        with_stream(stream)
        {result, buf2, st} = do_rpc(port, next_id, method, params, pick, buf)
        from ! {ref, result}
        continue(st, port, tools, buf2, next_id + 1)
      case :__close__
        jet_port_ffi::close(port)
      case {:DOWN, _mref, :process, _p, _reason}
        jet_port_ffi::close(port)
      case {p, {:exit_status, _st}} if p == port
        :ok
    end
  end

  # A server that died DURING a call has had its exit_status consumed inside recv, so
  # conn_loop's own exit_status clause can never fire for it. Without this the process
  # would live on around a dead port -- and alive?/1 would keep jet_agent::ensure_mcp_conns
  # reusing it, so every later tool call would block until the recv timeout, for the rest
  # of the agent's life. Exiting here lets the next turn open a fresh connection.
  def self.continue(st, port, tools, buf, next_id)
    if st == :closed
      jet_port_ffi::close(port)
    else
      conn_loop(port, tools, buf, next_id)
    end
  end

  # adopt the calling turn's event-stream target for the duration of this call, so the
  # server's progress/log notifications -- which arrive HERE, in the conn process -- reach
  # the same subscriber as the agent's own {:text}. :undefined leaves it unset (headless).
  def self.with_stream(stream)
    if stream == :undefined
      erlang::erase(:__acp_stream__)
    else
      erlang::put(:__acp_stream__, stream)
    end
  end

  # re-list only when the server said its tools changed (notifications/tools/list_changed,
  # recorded by on_notification in THIS process). Otherwise hand back the cached list.
  def self.refresh_tools(port, tools, buf, next_id)
    if erlang::get(:__mcp_tools_stale__) == true
      erlang::erase(:__mcp_tools_stale__)
      send_req(port, next_id, "tools/list", maps::new())
      match recv(port, buf, next_id)
        case {:ok, resp, rest}
          {descriptors(erlang::self(), tools_of(resp)), rest, next_id + 1}
        case {:error, _r, rest}
          {tools, rest, next_id + 1}
      end
    else
      {tools, buf, next_id}
    end
  end

  # each returns {result, remaining_buffer, :ok | :closed} -- the third element tells
  # conn_loop the server is gone, which recv has already consumed the exit_status for.
  def self.do_call(port, id, name, args, buf)
    send_req(port, id, "tools/call", {name: to_bin(name), arguments: args})
    match recv(port, buf, id)
      case {:ok, resp, rest}
        {extract(resp), rest, :ok}
      case {:error, reason, rest}
        {failure(<<"call">>, reason), rest, live_state(reason)}
    end
  end

  # one generic request/response, with `pick` naming what to pull out of the result.
  def self.do_rpc(port, id, method, params, pick, buf)
    send_req(port, id, method, params)
    match recv(port, buf, id)
      case {:ok, resp, rest}
        {pick_result(resp, pick), rest, :ok}
      case {:error, reason, rest}
        {{:error, reason}, rest, live_state(reason)}
    end
  end

  def self.live_state(reason)
    if reason == :closed
      :closed
    else
      :ok
    end
  end

  def self.pick_result(resp, pick)
    match pick
      case {:list, key}
        {:ok, result_list(resp, key)}
      case :text
        {:ok, extract(resp)}
      case :contents
        {:ok, contents_text(resp)}
      case :messages
        {:ok, messages_text(resp)}
      case _
        {:ok, maps::get(<<"result">>, resp, maps::new())}
    end
  end

  # resources/read -> {contents: [{uri, text}, ...]} -> joined text.
  def self.contents_text(resp)
    erlang::iolist_to_binary(lists::map({|c| to_bin(maps::get(<<"text">>, c, <<>>))},
                                        result_list(resp, <<"contents">>)))
  end

  # prompts/get -> {messages: [{role, content: {type,text}}, ...]} -> joined text.
  def self.messages_text(resp)
    erlang::iolist_to_binary(lists::map({|m| block_text(maps::get(<<"content">>, m, maps::new()))},
                                        result_list(resp, <<"messages">>)))
  end

  # --- worker-side: ask a conn process for its tools / to run a call or an rpc ---

  # generous, because this is usually the FIRST thing asked of a conn that is still doing
  # its handshake -- and a cold `npx -y …` server can take tens of seconds to boot. Giving
  # up early would silently hand the turn an empty tool list.
  def self.tools_of_conn(conn_pid)
    ask(conn_pid, {|from, ref| {:mcp_tools, from, ref}}, [], 60000)
  end

  # the conn process runs the call, so it -- not this worker -- is where the server's
  # progress notifications arrive. Hand it this turn's stream target so they still reach
  # the user (see conn_loop).
  def self.call_conn(conn_pid, name, args)
    stream = erlang::get(:__acp_stream__)
    ask(conn_pid, {|from, ref| {:mcp_call, from, ref, name, args, stream}},
        <<"mcp server not connected">>, 180000)
  end

  # --- the other two MCP primitives. `ref` is a conn process (the agent path) or a raw
  # port (one-shot), exactly as it is for a tool call. ---

  def self.resources(ref)
    request(ref, "resources/list", maps::new(), {:list, <<"resources">>})
  end

  def self.read_resource(ref, uri)
    request(ref, "resources/read", {uri: to_bin(uri)}, :contents)
  end

  def self.prompts(ref)
    request(ref, "prompts/list", maps::new(), {:list, <<"prompts">>})
  end

  def self.get_prompt(ref, name, args)
    request(ref, "prompts/get", {name: to_bin(name), arguments: args}, :messages)
  end

  def self.ping(ref)
    request(ref, "ping", maps::new(), :raw)
  end

  def self.request(ref, method, params, pick)
    if erlang::is_pid(ref)
      rpc(ref, method, params, pick)
    else
      port_rpc(ref, method, params, pick)
    end
  end

  def self.port_rpc(port, method, params, pick)
    {result, rest, _st} = do_rpc(port, next_id(port), method, params, pick, get_buf(port))
    put_buf(port, rest)
    result
  end

  def self.rpc(conn_pid, method, params, pick)
    stream = erlang::get(:__acp_stream__)
    ask(conn_pid, {|from, ref| {:mcp_rpc, from, ref, method, params, pick, stream}},
        {:error, :not_connected}, 150000)
  end

  # one request/reply round trip with the conn process, with a per-kind default when it is
  # gone or silent. `build` gets {from, ref} and returns the message the conn replies to.
  def self.ask(conn_pid, build, fallback, timeout)
    if alive?(conn_pid)
      ref = erlang::make_ref()
      conn_pid ! erlang::apply(build, [erlang::self(), ref])
      receive
        case {r, result} if r == ref
          result
      after timeout
        fallback
      end
    else
      fallback
    end
  end

  def self.alive?(pid)
    erlang::is_pid(pid) and erlang::is_process_alive(pid)
  end

  # --- server specs ---

  # config[:mcp] -> a list of server specs. A spec is a command string (`mcp "npx -y srv"`)
  # or a map for what a bare string cannot express:
  #   {command: "...", env: {KEY: "value"}, cwd: "/path"}
  def self.norm_specs(specs)
    if erlang::is_binary(specs) or erlang::is_map(specs)
      [specs]
    elsif erlang::is_list(specs)
      match specs
        case []
          []
        case [h, *_]
          if erlang::is_integer(h)
            [specs]                # a char list IS one command, not a list of specs
          else
            specs
          end
      end
    else
      []
    end
  end

  def self.spec_command(spec)
    if erlang::is_map(spec)
      maps::get(:command, spec, <<>>)
    else
      spec
    end
  end

  # port options from the spec: a working directory and extra environment variables, both
  # in the charlist form erlang:open_port wants.
  def self.spec_opts(spec)
    if erlang::is_map(spec)
      cwd_opt(maps::get(:cwd, spec, nil)) ++ env_opt(maps::get(:env, spec, nil))
    else
      []
    end
  end

  def self.cwd_opt(cwd)
    if cwd == nil
      []
    else
      [{:cd, to_list(cwd)}]
    end
  end

  def self.env_opt(env)
    if erlang::is_map(env)
      [{:env, lists::map({|kv| {to_list(erlang::element(1, kv)), to_list(erlang::element(2, kv))}},
                         maps::to_list(env))}]
    else
      []
    end
  end

  def self.open_port(spec, _config)
    jet_port_ffi::open(spec_command(spec), [:separate_stderr] ++ spec_opts(spec))
  end

  # --- ndjson JSON-RPC over the port ---

  # read ndjson lines until the response whose "id" == id. Everything else on the wire is
  # SERVED, not skipped: a server->client request is answered and a notification is routed
  # to the event bus. (Skipping a request is what leaves a server blocked forever.)
  #
  # BOTH outcomes carry the unconsumed remainder: {:ok, msg, rest} | {:error, reason, rest}.
  # Handing back the PRE-call buffer on failure would replay lines recv had already acted
  # on -- emitting a notification twice, or answering a server request twice with the same
  # JSON-RPC id.
  def self.recv(port, buf, id)
    match binary::split(buf, <<"\n">>)
      case [line, rest]
        match jet_json_ffi::decode(line)
          case {:ok, msg}
            match classify(msg, id)
              case :response
                {:ok, msg, rest}
              case :request
                serve_request(port, msg)
                recv(port, rest, id)
              case :notification
                on_notification(msg)
                recv(port, rest, id)
              case _
                recv(port, rest, id)
            end
          case _
            recv(port, rest, id)
        end
      case _
        receive
          case {p, {:data, data}} if p == port
            recv(port, erlang::iolist_to_binary([buf, data]), id)
          case {p, {:exit_status, _st}} if p == port
            {:error, :closed, buf}
        after 120000
          send_note(port, "notifications/cancelled",
                    {requestId: id, reason: "the jet client timed out waiting"})
          {:error, :timeout, buf}
        end
    end
  end

  def self.classify(msg, id)
    mid = maps::get(<<"id">>, msg, nil)
    if maps::is_key(<<"method">>, msg)
      if mid == nil
        :notification
      else
        :request
      end
    elsif mid == id
      :response
    else
      :other
    end
  end

  # --- server -> client requests (the mirror of jet_acp::handle_server_request) ---

  def self.serve_request(port, msg)
    id = maps::get(<<"id">>, msg, nil)
    params = maps::get(<<"params">>, msg, maps::new())
    match maps::get(<<"method">>, msg, nil)
      case <<"ping">>
        send_result(port, id, maps::new())
      case <<"roots/list">>
        send_result(port, id, {roots: roots()})
      case <<"sampling/createMessage">>
        serve_sampling(port, id, params)
      case _
        send_error(port, id, -32601, "method not supported by the jet MCP client")
    end
  end

  # MCP roots = the directories the server may work in -- the analogue of an ACP session's
  # workspace root, which jet_acp stashes in the process dict.
  def self.roots()
    dir = match erlang::get(:__mcp_root__)
            case :undefined
              cwd_bin()
            case r
              to_bin(r)
          end
    [{uri: erlang::iolist_to_binary(["file://", dir]), name: dir}]
  end

  def self.cwd_bin()
    match file::get_cwd()
      case {:ok, d}
        erlang::iolist_to_binary(d)
      case _
        <<"/">>
    end
  end

  # the server asks US to run a model. Run it on the AGENT'S OWN backend -- the same
  # borrowing jet_acp does in the other direction when an ACP agent asks us to read a file.
  # Silent: this is the server's plumbing, not the agent's answer.
  def self.serve_sampling(port, id, params)
    match erlang::get(:__mcp_backend__)
      case :undefined
        send_error(port, id, -32601, "this client has no backend to sample with")
      case backend
        match sample_with(backend, params)
          case {:ok, text}
            send_result(port, id, {role: "assistant", model: jet_backend::backend_label(backend),
                                   stopReason: "endTurn", content: {type: "text", text: text}})
          case {:error, reason}
            send_error(port, id, -32603, failure(<<"sampling">>, reason))
        end
    end
  end

  def self.sample_with(backend, params)
    try
      {:ok, to_bin(jet_backend::run_silent(backend, sampling_system(params), sampling_input(params)))}
    catch e
      {:error, e.get(:reason)}
    end
  end

  def self.sampling_system(params)
    to_bin(maps::get(<<"systemPrompt">>, params, <<"You are a helpful assistant.">>))
  end

  def self.sampling_input(params)
    msgs = maps::get(<<"messages">>, params, [])
    if erlang::is_list(msgs)
      erlang::iolist_to_binary(lists::map({|m| sampling_line(m)}, msgs))
    else
      <<>>
    end
  end

  def self.sampling_line(m)
    [to_bin(maps::get(<<"role">>, m, <<"user">>)), ": ",
     block_text(maps::get(<<"content">>, m, maps::new())), "\n"]
  end

  # --- server -> client notifications ---

  # surfaced on the SAME event bus as {:text}/{:trace} (jet_acp::emit_event), so an MCP
  # server's progress reaches a Console, an ACP client or a test instead of vanishing.
  def self.on_notification(msg)
    params = maps::get(<<"params">>, msg, maps::new())
    match maps::get(<<"method">>, msg, nil)
      case <<"notifications/progress">>
        note(maps::get(<<"message">>, params, <<>>))
      case <<"notifications/message">>
        note(log_text(params))
      case <<"notifications/tools/list_changed">>
        erlang::put(:__mcp_tools_stale__, true)
      case _
        :ok
    end
  end

  def self.note(text)
    t = to_bin(text)
    if t == <<>>
      :ok
    else
      jet_acp::emit_event({:thought, t})
    end
  end

  def self.log_text(params)
    data = maps::get(<<"data">>, params, <<>>)
    if erlang::is_binary(data)
      data
    else
      jet_json_ffi::encode(data)
    end
  end

  # --- per-connection context (the process that owns the port) ---

  # the agent's config, so a server->client request can be answered with the agent's own
  # backend and workspace. Set once by whoever owns the port.
  def self.stash(config)
    match backend_of(config)
      case nil
        :ok
      case b
        erlang::put(:__mcp_backend__, b)
    end
    match maps::get(:workspace, config, nil)
      case nil
        :ok
      case w
        erlang::put(:__mcp_root__, to_bin(w))
    end
  end

  # the agent's OWN backend, or nil when it has none (then `sampling` is not advertised).
  #
  # jet_backend can run an Ollama model or an ACP command, and nothing else -- resolve/4
  # maps ANY model string to {:ollama, …}, so a hosted-provider agent (`model "claude-…"`,
  # provider: :claude) would advertise sampling and then send that model name to the local
  # Ollama, which fails every time. Such an agent counts as having no backend here: a
  # capability we would refuse is worse than one we never offered.
  def self.backend_of(config)
    opts = jet_backend::opts(config)
    cmd = maps::get(:command, opts, nil)
    model = maps::get(:model, opts, nil)
    if (cmd == nil) and (not jet_llm::ollama?(model))
      nil
    else
      try
        jet_backend::resolve(cmd, model, nil, nil)
      catch _e
        nil
      end
    end
  end

  def self.remember_server(resp)
    result = maps::get(<<"result">>, resp, maps::new())
    erlang::put(:__mcp_server__, {proto: maps::get(<<"protocolVersion">>, result, nil),
                                  capabilities: maps::get(<<"capabilities">>, result, maps::new()),
                                  info: maps::get(<<"serverInfo">>, result, maps::new()),
                                  instructions: maps::get(<<"instructions">>, result, nil)})
  end

  # what the connected server told us about itself at initialize (protocol version,
  # capabilities, name/version, instructions).
  def self.server_info()
    match erlang::get(:__mcp_server__)
      case :undefined
        maps::new()
      case s
        s
    end
  end

  # --- send helpers ---

  def self.send_req(port, id, method, params)
    send_line(port, {jsonrpc: "2.0", id: id, method: method, params: params})
  end

  def self.send_note(port, method, params)
    send_line(port, {jsonrpc: "2.0", method: method, params: params})
  end

  def self.send_result(port, id, result)
    send_line(port, {jsonrpc: "2.0", id: id, result: result})
  end

  def self.send_error(port, id, code, message)
    send_line(port, {jsonrpc: "2.0", id: id, error: {code: code, message: to_bin(message)}})
  end

  def self.send_line(port, msg)
    jet_port_ffi::send_input(port, erlang::iolist_to_binary([jet_json_ffi::encode(msg), "\n"]))
  end

  # --- per-port state (process dict; the opening worker owns it) ---

  def self.next_id(port)
    n = match erlang::get({:__mcp_id__, port})
          case :undefined
            3
          case v
            v
        end
    erlang::put({:__mcp_id__, port}, n + 1)
    n
  end

  def self.get_buf(port)
    match erlang::get({:__mcp_buf__, port})
      case :undefined
        <<>>
      case b
        b
    end
  end

  def self.put_buf(port, b)
    erlang::put({:__mcp_buf__, port}, b)
  end

  def self.to_bin(x)
    if erlang::is_binary(x)
      x
    elsif erlang::is_atom(x)
      erlang::atom_to_binary(x, :utf8)
    elsif erlang::is_list(x)
      erlang::iolist_to_binary(x)
    elsif erlang::is_map(x)
      jet_json_ffi::encode(x)
    else
      erlang::iolist_to_binary(io_lib::format("~p", [x]))
    end
  end

  def self.to_list(x)
    erlang::binary_to_list(to_bin(x))
  end
end
