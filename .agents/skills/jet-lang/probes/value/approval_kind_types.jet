module approval_kind_types
  # The two paths that call on_approval disagree on the TYPE of :kind, so a policy
  # written for one silently no-ops on the other:
  #   ACP    (jet_acp::build_approval_req) converts to a char list -> `case "execute"` fires
  #   native (jet_llm's tool gate)         passes a binary         -> it does not
  # A policy that only matches one form allows everything on the other path.
  def self.run()
    r = jet_acp::build_approval_req(acp_msg())
    io::format("~p~n", [erlang::is_list(maps::get(:kind, r))])
    io::format("~p~n", [erlang::is_binary(<<"execute">>)])
    io::format("~p~n", ["execute" == <<"execute">>])
  end
  def self.acp_msg()
    maps::from_list([{<<"params">>,
      maps::from_list([{<<"toolCall">>, maps::from_list([{<<"kind">>, <<"execute">>}])}])}])
  end
end
